# 将本文件复制为 `.env` 并填入真实值。
# 真实的 `.env` 已被 gitignore 忽略，绝不能提交。

# --- LLM 提供商 ---
# 通过 LLM_PROVIDER 选择其中一个提供商。支持："gemini" | "groq"。
LLM_PROVIDER=groq

# Gemini：在 https://aistudio.google.com/apikey 免费获取密钥
# （注意：gemini-2.5-flash 免费档约为每天 20 次请求。）
# 即使 LLM_PROVIDER=groq 也必须配置：简历证据检索始终使用
# Gemini 免费档的 embedding API（Groq 没有 embeddings API）。
GOOGLE_API_KEY=your-gemini-api-key-here

# Groq：在 https://console.groq.com/keys 免费获取密钥（无需绑卡）。
# 免费额度高得多（约每天 14,400 次请求）。
GROQ_API_KEY=your-groq-api-key-here

# 所选提供商的模型名。未设置时使用合理的默认值。
#   gemini -> gemini-2.5-flash | gemini-2.0-flash
#   groq   -> openai/gpt-oss-20b
LLM_MODEL=openai/gpt-oss-20b

# 简历证据检索使用的 embedding 模型（始终为 Gemini，见上文）。
# 未设置时默认为 "gemini-embedding-001"。
EMBEDDING_MODEL=gemini-embedding-001

# --- 应用 ---
APP_ENV=development
LOG_LEVEL=INFO
